[ext_resource type="Resource" path="res://resources/enchantments/composite/meteorite.tres" id="new_meteorite"]

[resource]
script = ExtResource("rules")
allowed_enchantments = Array[ExtResource("enchantment")]([ExtResource("e0"), ExtResource("e1"), ExtResource("e2"), ExtResource("e3"), ExtResource("new_solar_flare"), ExtResource("new_pyroclastic"), ExtResource("new_geyser"), ExtResource("new_magma"), ExtResource("new_volcano"), ExtResource("new_fusion"), ExtResource("new_obsidian"), ExtResource("new_meteorite")])
