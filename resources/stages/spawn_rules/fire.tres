[gd_resource type="Resource" script_class="StageSpawnRules" format=3]

[ext_resource type="Script" path="res://scripts/progression/stage_spawn_rules.gd" id="rules"]
[ext_resource type="Script" path="res://scripts/enchantments/enchantment.gd" id="enchantment"]
[ext_resource type="Resource" path="res://resources/enchantments/basic/cat.tres" id="e0"]
[ext_resource type="Resource" path="res://resources/enchantments/basic/fire.tres" id="e1"]
[ext_resource type="Resource" path="res://resources/enchantments/composite/lava.tres" id="e2"]
[ext_resource type="Resource" path="res://resources/enchantments/composite/plasma.tres" id="e3"]

[ext_resource type="Resource" path="res://resources/enchantments/composite/solar_flare.tres" id="new_solar_flare"]
[ext_resource type="Resource" path="res://resources/enchantments/composite/pyroclastic.tres" id="new_pyroclastic"]
[ext_resource type="Resource" path="res://resources/enchantments/composite/geyser.tres" id="new_geyser"]
[ext_resource type="Resource" path="res://resources/enchantments/composite/magma.tres" id="new_magma"]
[ext_resource type="Resource" path="res://resources/enchantments/composite/volcano.tres" id="new_volcano"]
[ext_resource type="Resource" path="res://resources/enchantments/composite/fusion.tres" id="new_fusion"]
