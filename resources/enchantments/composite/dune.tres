[resource]
script = ExtResource("script")
worm_enchantment = ExtResource("worm")
display_name = "Dune"
primary_color = Color(0.882353, 0.698039, 0.450980, 1)
description = "When this Squeeb faints, a Worm swallows it, the Squeeb immediately in front (an ally or the front enemy), and the ally immediately behind. The Worm gains their combined attack and remaining health. Swallowed Squeebs do not trigger fainting abilities."
