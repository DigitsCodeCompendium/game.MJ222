[gd_resource type="Resource" script_class="EnchantmentPlanet" format=3]

[ext_resource type="Script" path="res://scripts/enchantments/composite/enchantment_planet.gd" id="script"]
[ext_resource type="Resource" path="res://resources/enchantments/composite/mountain.tres" id="a"]

[ext_resource type="Resource" path="res://resources/status_effects/rings.tres" id="rings"]
[ext_resource type="Resource" path="res://resources/enchantments/special/fragment.tres" id="fragment"]

[resource]
script = ExtResource("script")
rings_effect = ExtResource("rings")
fragment_enchantment = ExtResource("fragment")

display_name = "Planet"
primary_color = Color(0.419608, 0.623529, 0.533333, 1)
description = "Counts every base element in the teammate directly behind it, including repeated components. After attacking, gain +1 health per Earth for the rest of combat and deal 1 damage to a random enemy per Air. On fainting, give the next living teammate 1 Rings stack per Water (each reduces incoming damage by 1, to a minimum of 1). If there is any Fire, also summon two ability-free 3/3 Fragments, each gaining +1/+1 per Fire element. Excess summons are tossed away."
base_attack = 5
base_health = 5
component1 = ExtResource("a")
component2 = ExtResource("a")
