[gd_resource type="Resource" script_class="ChilledStatusEffect" format=3]

[ext_resource type="Script" path="res://scripts/battle/status_effects/chilled_status_effect.gd" id="script"]

[resource]
script = ExtResource("script")
status_id = &"chilled"
display_name = "Chilled"
description = "Normal attacks deal 1 less damage, to a minimum of 1. At the end of each turn, lose 1 stack that was present at the start of that turn. Newly applied stacks last into the following turn. Abilities can also consume or remove stacks."
stackable = true
