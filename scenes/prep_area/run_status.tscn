[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/prep_area/run_status.gd" id="script"]

[sub_resource type="StyleBoxFlat" id="Panel"]
content_margin_left = 14.0
content_margin_right = 14.0
content_margin_top = 10.0
content_margin_bottom = 10.0
bg_color = Color(0.92, 0.85, 0.73, 0.98)
border_width_top = 2
border_width_bottom = 2
border_width_left = 2
border_width_right = 2
border_color = Color(0.63, 0.5, 0.35, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_left = 12
corner_radius_bottom_right = 12

[node name="RunStatus" type="PanelContainer"]
mouse_filter = 2
script = ExtResource("script")
theme_override_styles/panel = SubResource("Panel")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 5

[node name="Lives" type="Label" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 17
theme_override_colors/font_color = Color(0.24, 0.19, 0.14, 1)
text = "Lives left: 3"

[node name="Rounds" type="Label" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.35, 0.29, 0.23, 1)
text = "Rounds left: 10"

[node name="Stakes" type="Label" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.65, 0.23, 0.18, 1)
text = "Lose 1 life on defeat"
